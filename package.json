{
  "name": "wireskein-web",
  "version": "0.0.4",
  "description": "The browser side of WireSkein: read logic-analyzer capture files (.wsc) and show them.",
  "type": "module",
  "license": "MIT",
  "author": "TANAKA Masayuki",
  "sideEffects": false,
  "main": "dist/wireskein-web.js",
  "module": "dist/wireskein-web.js",
  "browser": "dist/wireskein-web.min.js",
  "unpkg": "dist/wireskein-web.min.js",
  "jsdelivr": "dist/wireskein-web.min.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/wireskein-web.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "site",
    "src",
    "types",
    "CHANGELOG.md",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "logic-analyzer",
    "waveform",
    "embedded",
    "wireskein",
    "oep"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Embedded-Probe/wireskein-web.git"
  },
  "bugs": {
    "url": "https://github.com/Open-Embedded-Probe/wireskein-web/issues"
  },
  "homepage": "https://open-embedded-probe.github.io/wireskein-web/",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:watch": "node scripts/run-tests.js --watch",
    "build": "node scripts/build.js",
    "build:site": "node scripts/build-site.js",
    "serve": "node scripts/serve.js",
    "types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "smoke:dist": "node scripts/smoke-dist.js",
    "check": "npm run test && npm run typecheck",
    "prepack": "npm run build && npm run types && npm run build:site",
    "preversion": "npm run check && node scripts/check-releasable.js",
    "version": "node scripts/sync-version.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
